{
  "name": "travel-ai-ha-giang",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "prisma generate && npm run build:client && npm run build:server",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:int": "vitest run --configLoader native --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "eval": "tsx eval/run-eval.ts",
    "trace": "tsx scripts/show-trace.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx db/seed.ts",
    "db:sync-explore": "tsx scripts/sync-explore-destinations.ts",
    "db:crawl": "tsx scripts/crawl-web.ts",
    "db:ingest": "tsx scripts/ingest-knowledge.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "build:client": "vite build --configLoader native",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --define:__BUILT_FOR_PRODUCTION__=true --outfile=dist/server.cjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:smoke": "node scripts/smoke-production.cjs",
    "db:migrate:check": "tsx scripts/migration-check.ts",
    "eval:leakage": "tsx eval/golden/check-leakage.ts",
    "db:audit": "tsx scripts/corpus-audit.ts",
    "eval:setup": "node scripts/setup-eval-venv.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
