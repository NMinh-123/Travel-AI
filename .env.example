# ---------------------------------------------------------------------------
# Database (bắt buộc)
# ---------------------------------------------------------------------------
# Thiếu biến này server dừng ngay khi khởi động thay vì chạy với giá trị mặc định.
# Giá trị dưới đây khớp với docker-compose.yml:  docker compose up -d db
DATABASE_URL="postgresql://travel:travel@localhost:5432/travelai"

# ---------------------------------------------------------------------------
# Khoá ký session (bắt buộc, tối thiểu 32 ký tự)
# ---------------------------------------------------------------------------
# Sinh khoá mới:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Đổi khoá này sẽ làm mọi phiên đăng nhập hiện có mất hiệu lực.
# KHÔNG commit giá trị thật — .env đã nằm trong .gitignore.
JWT_SECRET=""

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Bắt buộc để gọi Gemini API.
# Thiếu biến này, các endpoint /api/chat và /api/plan-itinerary trả về HTTP 503.
GEMINI_API_KEY=""

# GEMINI_BASE_URL: Điểm cuối của Gemini API. Để trống thì dùng mặc định của Google
# (https://generativelanguage.googleapis.com). Chỉ đặt khi khoá được cấp bởi một proxy trung
# gian — khi đó MỌI lượt gọi model (chat, năm tác tử, sinh lịch trình, và cả embedder nếu
# EMBEDDER="gemini") đều đi qua địa chỉ này, tức toàn bộ nội dung hội thoại đi qua bên thứ ba.
#
# Giá trị phải là ORIGIN, KHÔNG kèm "/v1": SDK @google/genai tự ghép thành
# {GEMINI_BASE_URL}/v1beta/models/... Trang hướng dẫn của các proxy thường in sẵn hậu tố "/v1"
# vì đó là dạng OpenAI-compatible; server tự cắt hậu tố đó nếu bạn dán nguyên, nhưng đặt đúng
# origin ngay từ đầu vẫn rõ ràng hơn. Giá trị không phải URL http(s) sẽ làm server dừng ngay.
GEMINI_BASE_URL=""

# GEMINI_MODEL: Tên model dùng cho cả chat và sinh lịch trình.
# Mặc định "gemini-2.5-flash" nếu không đặt. Xem danh sách model khả dụng tại
# https://ai.google.dev/gemini-api/docs/models trước khi đổi.
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_MODEL_LIGHT: Model tầng nhẹ cho phân loại ý định, trích xuất thực thể và FAQ ngắn —
# khoảng 70% lượt gọi của chatbot (SRS Mục 11.4.5). Phân tầng giúp giữ ngưỡng phản hồi <= 3 giây.
# Mặc định "gemini-2.5-flash-lite". XÁC MINH tên model với API trước khi chạy thật lần đầu.
GEMINI_MODEL_LIGHT="gemini-2.5-flash-lite"

# ---------------------------------------------------------------------------
# Tầng RAG của chatbot (không bắt buộc)
# ---------------------------------------------------------------------------
# EMBEDDER: nguồn sinh vector cho kho tri thức. Hai lựa chọn, cả hai đều ra 1024 chiều nên đổi
# qua lại không phải migrate cột — NHƯNG phải chạy lại `npm run db:ingest`, vì hai model sinh ra
# hai không gian vector khác nhau.
#   bge-m3  (mặc định) — dịch vụ Python cục bộ, dữ liệu không rời khỏi máy
#   gemini             — gọi API, không cần dựng sidecar nhưng văn bản đi ra ngoài
EMBEDDER="bge-m3"

# Địa chỉ sidecar embedding. Chỉ bind localhost — dịch vụ này không có xác thực.
#   venv\Scripts\python.exe -m uvicorn embedding-service.main:app --port 8000
EMBEDDING_SERVICE_URL="http://127.0.0.1:8000"

# RERANK_ENABLED: bật bước xếp hạng lại bằng cross-encoder. Mặc định false vì SRS Mục 11.4.4 yêu
# cầu đo mức cải thiện trên tập câu hỏi vàng trước khi bật — tập đó chưa có. Bật thì sidecar sẽ
# tải thêm model BGE-reranker-v2-m3 (~2,2GB) ở lần gọi đầu.
RERANK_ENABLED="false"

# VI_SEGMENT_ENABLED: tách từ tiếng Việt cho nhánh tìm kiếm từ khoá. Mặc định false.
# CẢNH BÁO: tách từ phải ĐỐI XỨNG giữa lúc nạp và lúc truy vấn. Bật biến này thì BẮT BUỘC chạy
# lại `npm run db:ingest`, nếu không chỉ mục và truy vấn ở hai dạng khác nhau và âm thầm không
# khớp được gì. Bật cũng cần cài thêm: pip install underthesea
VI_SEGMENT_ENABLED="false"

# RAG_MIN_VECTOR_SIMILARITY và RAG_MIN_KEYWORD_RANK: ngưỡng liên quan của hai nhánh truy xuất.
# Đoạn nào không vượt ngưỡng ở nhánh nào cả thì bị loại; khi không còn đoạn nào, tác tử tri thức
# trả `grounded: false` và chuyển tiếp thay vì để model đoán từ những đoạn không liên quan.
#
# Cần hai ngưỡng vì mỗi nhánh mạnh ở một kiểu truy vấn: tương đồng cosine tách tốt câu tiếng Việt
# CÓ DẤU nhưng chấm điểm câu gõ KHÔNG DẤU rất thấp, còn ts_rank thì chấm câu không dấu y như câu
# có dấu (cấu hình `vietnamese` bỏ dấu ở cả hai phía). Vượt một nhánh là đủ để được giữ.
#
# Ngưỡng từ khoá 0,26 chỉ đúng KHI có chiều địa danh (bảng Place): từ điển địa danh chặn câu hỏi
# về địa bàn khác trước khi truy xuất chạy, nên ngưỡng chỉ còn phải lọc theo chủ đề. Đo trên 45
# câu: 25/25 hợp lệ, 0/12 ngoài địa bàn, 0/8 khác chủ đề. Hạ tiếp xuống 0,22 thì âm tính lọt ngay,
# tức biên an toàn chỉ khoảng 0,04. Đây là tập tự soạn với kho 31 đoạn, chưa phải tập câu hỏi vàng
# theo SRS Mục 11.4.4 — đổi nội dung kho thì phải đo lại. Đặt cả hai về 0 để tắt lọc.
RAG_MIN_VECTOR_SIMILARITY="0.6"
RAG_MIN_KEYWORD_RANK="0.26"

# ---------------------------------------------------------------------------
# Đăng nhập Google (không bắt buộc)
# ---------------------------------------------------------------------------
# Lấy OAuth 2.0 Client ID loại "Web application" tại https://console.cloud.google.com
# và thêm origin của bạn (ví dụ http://localhost:3000) vào "Authorized JavaScript origins".
# Không đặt biến này thì nút đăng nhập Google tự ẩn, phần đăng nhập bằng email vẫn hoạt động.
# Client ID là thông tin công khai, server gửi nó xuống trình duyệt qua GET /api/config.
GOOGLE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Địa chỉ server
# ---------------------------------------------------------------------------
# PORT / HOST: Địa chỉ server lắng nghe. Mặc định 3000 và 0.0.0.0.
# Lưu ý: mở trình duyệt bằng http://localhost:<PORT>, không phải 0.0.0.0.
PORT="3000"
HOST="0.0.0.0"

# ---------------------------------------------------------------------------
# Quy trình review (không bắt buộc — xem docs/dev-flow.md)
# ---------------------------------------------------------------------------
# Cả hai bước review (duyệt kế hoạch và soát code) đều đi qua Codex CLI, chạy bằng tài khoản
# ChatGPT đã đăng nhập sẵn trên máy — KHÔNG cần OPENAI_API_KEY và không tốn tiền theo token.
# Kiểm tra đăng nhập:  codex login status
#
# Quy trình vẫn chạy được ở chế độ thủ công mà không cần biến nào dưới đây: copy gói prompt
# trong docs/plans/<task>/ sang ChatGPT rồi dán kết quả về.

# CODEX_BIN: chỉ đặt khi `codex` không nằm trên PATH. Script tự thử PATH trước, rồi tới bản
# cài standalone ở ~/.codex/packages/standalone/current/bin/ — trỏ vào symlink `current` nên
# không chết sau mỗi lần `codex update`.
CODEX_BIN=""

# CODEX_REVIEW_MODEL: để trống thì dùng model mặc định của Codex. Chỉ đặt khi muốn ghim một
# model cụ thể cho bước review.
CODEX_REVIEW_MODEL=""
